//@version=5
indicator("Setup Replication & Volume Profile with Historical Signals", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ===== 1. CHART STYLING & CANDLESTICKS =====
grp_cand = "1. Chart Styling & Candlesticks"
bg_color   = input.color(#0d1117, "Chart Dark Background", group=grp_cand)
bull_color = input.color(#f3ba2f, "Bullish Candle Fill", group=grp_cand)
bear_color = input.color(#1a1d24, "Bearish Candle Fill", group=grp_cand)
bull_border = input.color(#4a5c68, "Bullish Candle Border/Wick", group=grp_cand)
bear_border = input.color(#2a2e39, "Bearish Candle Border/Wick", group=grp_cand)

// Apply dark background
bgcolor(bg_color, title="Chart Background")

// Custom Candlestick colors
plotcandle(open, high, low, close, title="Custom Candles",
           color=close >= open ? bull_color : bear_color,
           wickcolor=close >= open ? bull_border : bear_border,
           bordercolor=close >= open ? bull_border : bear_border)

// ===== 2. LEFT-SIDE VOLUME PROFILE =====
grp_vp = "2. Left-Side Volume Profile"
vp_start_offset = input.int(220, "VP Start Bar Offset", minval=10, group=grp_vp, tooltip="Bars back from current bar for VP start boundary")
vp_end_offset   = input.int(110, "VP End Bar Offset", minval=5, group=grp_vp, tooltip="Bars back from current bar for VP end boundary")
vp_rows         = input.int(45, "VP Smoothness (Rows)", minval=10, group=grp_vp)
vp_va_pct       = input.float(0.70, "Value Area %", minval=0.1, maxval=1.0, step=0.05, group=grp_vp)
vp_width_bars   = input.int(45, "Histogram Max Width (Bars)", minval=5, group=grp_vp)

col_va_bars    = input.color(#f3ba2f, "Value Area Bars Color", group=grp_vp)
col_non_va     = input.color(#4a5e6e, "Outside Value Area Bars Color", group=grp_vp)
col_box_border = input.color(#62647a, "VP Box Border Color", group=grp_vp)
col_box_bg     = input.color(color.new(#131722, 90), "VP Box Background Fill", group=grp_vp)

// ===== 3. GLOBAL KEY LEVEL =====
grp_poc = "3. Global Key Level"
col_poc_line   = input.color(#e53935, "POC Global Line Color", group=grp_poc)
poc_line_width = input.int(2, "POC Global Line Width", minval=1, group=grp_poc)

// ===== 4. POSITION CONFIGURATION & HISTORICAL =====
grp_setup = "4. Long/Short Setup & Historical Settings"
position_mode   = input.string("Both", "Trade Mode", options=["Long", "Short", "Both", "Static Only"], group=grp_setup)
trigger_type    = input.string("POC Breakout", "Signal Trigger Type", options=["POC Breakout", "EMA Crossover"], group=grp_setup)
show_historical = input.bool(true, "Show Historical Setup Boxes", group=grp_setup)
max_hist_trades = input.int(10, "Max Historical Setup Boxes to Plot", minval=1, maxval=50, group=grp_setup)

sl_multiplier   = input.float(1.5, "Stop Loss ATR Multiplier", minval=0.1, step=0.1, group=grp_setup)
tp_multiplier   = input.float(3.5, "Take Profit ATR Multiplier", minval=0.1, step=0.1, group=grp_setup)
atr_len         = input.int(14, "ATR Length for Targets", minval=1, group=grp_setup)

col_sl_bg      = input.color(color.new(#ef5350, 85), "Stop Loss Box BG", group=grp_setup)
col_tp_bg      = input.color(color.new(#005a54, 80), "Take Profit Box BG (Long TP / Short TP)", group=grp_setup)
col_tp_long_bg = input.color(color.new(#005a54, 80), "Long Take Profit Box BG", group=grp_setup)

// ===== 5. POSITION DETAIL - TARGET LINE =====
grp_target = "5. Position Target Line"
target_width_bars = input.int(15, "Target Line Box Width (Bars)", minval=1, group=grp_target)
col_target_line   = input.color(#85929e, "Target Line Color", group=grp_target)

// ===== CUSTOM USER DEFINED TYPE FOR POSITION DRAWINGS =====
type TradePosition
    box sl_box
    box tp_box
    line target_line
    line stem_line
    line wing_l
    line wing_r

// Storage for "Live" VP objects (to clean and redraw)
var box[] liveVPBoxes   = array.new_box(0)
var line[] liveVPLines  = array.new_line(0)

// Persistent arrays for historical trades
var TradePosition[] histPositions = array.new<TradePosition>(0)

// Function to delete older drawings when historical trade count limit is reached
prune_old_positions(int max_count) =>
    while array.size(histPositions) > max_count
        TradePosition oldest = array.shift(histPositions)
        box.delete(oldest.sl_box)
        box.delete(oldest.tp_box)
        line.delete(oldest.target_line)
        line.delete(oldest.stem_line)
        line.delete(oldest.wing_l)
        line.delete(oldest.wing_r)

// ===== MAIN CALCULATION =====
atr = ta.atr(atr_len)

// Technical triggers
ema_fast = ta.ema(close, 9)
ema_slow = ta.ema(close, 21)
ema_cross_up   = ta.crossover(ema_fast, ema_slow)
ema_cross_down = ta.crossunder(ema_fast, ema_slow)

// Dynamic boundary calculations for left-side VP
start_idx = vp_start_offset
end_idx = vp_end_offset

if start_idx < end_idx
    int temp = start_idx
    start_idx := end_idx
    end_idx := temp

// Perform historical Volume Profile scanning for dynamic POC
var float pocPrice = na

if barstate.islast and bar_index >= start_idx
    // Clear previous VP drawings
    while array.size(liveVPBoxes) > 0
        box.delete(array.pop(liveVPBoxes))
    while array.size(liveVPLines) > 0
        line.delete(array.pop(liveVPLines))

    // Identify Highest High and Lowest Low in the specified window
    float vp_high = na
    float vp_low = na
    for i = end_idx to start_idx
        if na(vp_high) or high[i] > vp_high
            vp_high := high[i]
        if na(vp_low) or low[i] < vp_low
            vp_low := low[i]

    // Populate Volume Profile Bins
    float vp_range = math.max(vp_high - vp_low, syminfo.mintick * 10)
    float step = vp_range / vp_rows
    float[] volBins = array.new_float(vp_rows, 0.0)

    for i = end_idx to start_idx
        float bar_h = high[i]
        float bar_l = low[i]
        float bar_v = volume[i]
        if bar_v > 0
            for r = 0 to vp_rows - 1
                float r_bot = vp_low + r * step
                float r_top = vp_low + (r + 1) * step
                float overlap_bot = math.max(bar_l, r_bot)
                float overlap_top = math.min(bar_h, r_top)
                if overlap_top > overlap_bot and (bar_h - bar_l) > 0
                    float pct = (overlap_top - overlap_bot) / (bar_h - bar_l)
                    array.set(volBins, r, array.get(volBins, r) + bar_v * pct)
                else if (bar_h - bar_l) <= 0 and bar_h >= r_bot and bar_h <= r_top
                    array.set(volBins, r, array.get(volBins, r) + bar_v)

    // Calculate POC & Value Area Boundaries
    float maxVol = array.max(volBins)
    float totalVol = array.sum(volBins)
    int pocIdx = array.indexof(volBins, maxVol)
    pocPrice := vp_low + pocIdx * step + step * 0.5

    float targetVA = totalVol * vp_va_pct
    float currentVA = maxVol
    int va_low_idx = pocIdx
    int va_high_idx = pocIdx

    int loop_guard = 0
    while currentVA < targetVA and loop_guard < vp_rows
        float vUp = (va_high_idx < vp_rows - 1) ? array.get(volBins, va_high_idx + 1) : 0.0
        float vDn = (va_low_idx > 0) ? array.get(volBins, va_low_idx - 1) : 0.0
        if vUp == 0.0 and vDn == 0.0
            break
        if vUp >= vDn and va_high_idx < vp_rows - 1
            currentVA += vUp
            va_high_idx += 1
        else if va_low_idx > 0
            currentVA += vDn
            va_low_idx -= 1
        else if va_high_idx < vp_rows - 1
            currentVA += vUp
            va_high_idx += 1
        loop_guard += 1

    // Draw VP Outer Frame Box
    int vp_box_left  = bar_index - start_idx
    int vp_box_right = bar_index - end_idx
    vp_box = box.new(left=vp_box_left, top=vp_high, right=vp_box_right, bottom=vp_low,
                     border_color=col_box_border, border_width=1, border_style=line.style_solid,
                     bgcolor=col_box_bg)
    array.push(liveVPBoxes, vp_box)

    // Draw Volume Profile Histogram Rows
    for r = 0 to vp_rows - 1
        float v = array.get(volBins, r)
        float pct = maxVol == 0 ? 0 : v / maxVol
        int bar_width = int(pct * vp_width_bars)
        int row_left = vp_box_left
        int row_right = math.min(row_left + bar_width, vp_box_right)

        float r_bot = vp_low + r * step
        float r_top = vp_low + (r + 1) * step

        bool is_va = r >= va_low_idx and r <= va_high_idx
        color row_color = is_va ? col_va_bars : col_non_va

        if v > 0 and row_right > row_left
            row_box = box.new(left=row_left, bottom=r_bot, right=row_right, top=r_top,
                               bgcolor=color.new(row_color, 40), border_color=color.new(row_color, 60),
                               border_width=1, border_style=line.style_solid)
            array.push(liveVPBoxes, row_box)

    // Draw Global Horizontal Key Level Line (POC)
    l_global_poc = line.new(x1=vp_box_left - 150, y1=pocPrice, x2=bar_index + 150, y2=pocPrice,
                            color=col_poc_line, width=poc_line_width, style=line.style_solid, extend=extend.both)
    array.push(liveVPLines, l_global_poc)

// Get consistent POC price across historical checks
var float hist_poc = na
if not na(pocPrice)
    hist_poc := pocPrice

// ===== SIGNAL SCANNING & POSITION DRAWING LOGIC =====
bool is_long_signal  = false
bool is_short_signal = false

if trigger_type == "POC Breakout" and not na(hist_poc)
    is_long_signal  := ta.crossover(close, hist_poc)
    is_short_signal := ta.crossunder(close, hist_poc)
else if trigger_type == "EMA Crossover"
    is_long_signal  := ema_cross_up
    is_short_signal := ema_cross_down

// Handle Long and Short Execution
bool trigger_long  = is_long_signal and (position_mode == "Long" or position_mode == "Both")
bool trigger_short = is_short_signal and (position_mode == "Short" or position_mode == "Both")

// Execute and Draw Setup
if show_historical and (trigger_long or trigger_short) and not na(atr)
    float entry = close
    float stop = trigger_long ? entry - atr * sl_multiplier : entry + atr * sl_multiplier
    float target = trigger_long ? entry + atr * tp_multiplier : entry - atr * tp_multiplier

    // Box dimensions
    int b_left  = bar_index
    int b_right = bar_index + target_width_bars

    color bg_sl = col_sl_bg
    color bg_tp = trigger_long ? col_tp_long_bg : col_tp_bg

    box sl_box_obj = box.new(left=b_left, bottom=trigger_long ? stop : entry, right=b_right, top=trigger_long ? entry : stop,
                             bgcolor=bg_sl, border_color=color.new(bg_sl, 30), border_width=1)

    box tp_box_obj = box.new(left=b_left, bottom=trigger_long ? entry : target, right=b_right, top=trigger_long ? target : entry,
                             bgcolor=bg_tp, border_color=color.new(bg_tp, 30), border_width=1)

    // Arrow line and vertical terminal pointer
    int target_start_x = bar_index
    float target_start_y = trigger_long ? low : high
    int target_end_x = b_right
    float target_end_y = target

    line arrow_line = line.new(x1=target_start_x, y1=target_start_y, x2=target_end_x, y2=target_end_y,
                               color=col_target_line, width=1, style=line.style_dashed)

    // Terminal vertical arrow pointing at target boundary
    float stem_y_start = trigger_long ? target - atr * 0.15 : target + atr * 0.15
    line stem_line = line.new(x1=target_end_x, y1=stem_y_start, x2=target_end_x, y2=target_end_y,
                              color=col_target_line, width=1, style=line.style_solid)

    float wing_y = trigger_long ? target - atr * 0.05 : target + atr * 0.05
    line wing_l = line.new(x1=target_end_x, y1=target_end_y, x2=target_end_x - 1, y2=wing_y,
                           color=col_target_line, width=1, style=line.style_solid)
    line wing_r = line.new(x1=target_end_x, y1=target_end_y, x2=target_end_x + 1, y2=wing_y,
                           color=col_target_line, width=1, style=line.style_solid)

    TradePosition tp = TradePosition.new(sl_box_obj, tp_box_obj, arrow_line, stem_line, wing_l, wing_r)
    array.push(histPositions, tp)

    // Maintain trade drawing limits to prevent resource exhaustion
    prune_old_positions(max_hist_trades)

// ===== STATIC DEMO OPTION (Original hard-coded setup at hard-right edge) =====
var box static_sl = na
var box static_tp = na
var line static_arrow = na
var line static_stem = na
var line static_wl = na
var line static_wr = na

if barstate.islast and (position_mode == "Static Only" or not show_historical)
    // Clean old static drawings
    box.delete(static_sl)
    box.delete(static_tp)
    line.delete(static_arrow)
    line.delete(static_stem)
    line.delete(static_wl)
    line.delete(static_wr)

    // Draw static short setup as fallback
    float entry_price = na(hist_poc) ? close : hist_poc
    float stop_price  = entry_price + atr * sl_multiplier
    float tp_price    = entry_price - atr * tp_multiplier

    int short_left  = bar_index - 55
    int short_right = bar_index + 20

    static_sl := box.new(left=short_left, bottom=entry_price, right=short_right, top=stop_price,
                          bgcolor=col_sl_bg, border_color=color.new(col_sl_bg, 30), border_width=1)

    static_tp := box.new(left=short_left, bottom=tp_price, right=short_right, top=entry_price,
                          bgcolor=col_tp_bg, border_color=color.new(col_tp_bg, 30), border_width=1)

    int target_start_x = bar_index - 40
    float target_start_y = high[40]
    int target_end_x = bar_index
    float target_end_y = tp_price

    static_arrow := line.new(x1=target_start_x, y1=target_start_y, x2=target_end_x, y2=target_end_y,
                             color=col_target_line, width=1, style=line.style_dashed)

    float stem_y_start = tp_price + atr * 0.15
    static_stem := line.new(x1=target_end_x, y1=stem_y_start, x2=target_end_x, y2=target_end_y,
                            color=col_target_line, width=1, style=line.style_solid)

    float wing_y = tp_price + atr * 0.05
    static_wl := line.new(x1=target_end_x, y1=target_end_y, x2=target_end_x - 1, y2=wing_y,
                          color=col_target_line, width=1, style=line.style_solid)
    static_wr := line.new(x1=target_end_x, y1=target_end_y, x2=target_end_x + 1, y2=wing_y,
                          color=col_target_line, width=1, style=line.style_solid)
