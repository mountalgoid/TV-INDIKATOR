//@version=6
indicator("Liquidity Heatmap V4 𝙈𝙤𝙪𝙣𝙩𝘼𝙡𝙜𝙤", shorttitle="LQ Heatmap V4 𝙈𝙤𝙪𝙣𝙩𝘼𝙡𝙜𝙤", overlay=true, max_lines_count=500, max_boxes_count=500, max_bars_back=2000)

// -----------------------------------------------------------------------------
// 0. USER DEFINED TYPES
// -----------------------------------------------------------------------------
type LiqZone
    line t_ln
    line m_ln
    line b_ln
    linefill f_top
    linefill f_bot
    float level
    float step
    float strength
    bool is_long_liq
    bool active

// -----------------------------------------------------------------------------
// 1. INPUTS & CONFIGURATION
// -----------------------------------------------------------------------------
string GlobalGroup = "Visual Themes & Global"
string grp_liq     = "Liquidity Engine & Heatmap Settings"
string grp_dom     = "DOM Liquidity Profile (Right Candle)"

// --- THEME SYSTEM ---
string color_theme = input.string(defval = 'DEX Deep', title = 'Select Color Theme', options = ['Spartan Edge Theme', 'MountAlgo Themes', 'MountAlgo Neon', 'MountAlgo Frost', 'MountAlgo Cyber', 'Standard Spartan Edge Theme', 'Dark ICT Theme', 'Garuda Gold', 'MountAlgo Super Premium Theme', 'MountAlgo Orange White Theme', 'DEX Deep', 'Deep Sea'], group=GlobalGroup)

// Colors
color dark   = #000000
color white  = #c4d3ff
color green  = #179c74
color purple = #5134ff
color gray   = #62647a
color red    = #f23645
color yellow = #f3ba2f
color orange = #ff9800
color blue   = #1848cc

color col_bull = switch color_theme
    'Spartan Edge Theme' => red
    'MountAlgo Themes' => purple
    'MountAlgo Neon' => #5134ff
    'MountAlgo Frost' => #5134ff
    'MountAlgo Cyber' => #1848cc
    'Standard Spartan Edge Theme' => green
    'Dark ICT Theme' => green
    'Garuda Gold' => yellow
    'MountAlgo Super Premium Theme' => purple
    'MountAlgo Orange White Theme' => orange
    'DEX Deep' => #a1ff3b
    'Deep Sea' => blue
    => blue
color col_bear = switch color_theme
    'Spartan Edge Theme' => gray
    'MountAlgo Themes' => green
    'MountAlgo Neon' => #ff009a
    'MountAlgo Frost' => #00e5ff
    'MountAlgo Cyber' => #ff009a
    'Standard Spartan Edge Theme' => red
    'Dark ICT Theme' => gray
    'Garuda Gold' => gray
    'MountAlgo Super Premium Theme' => yellow
    'MountAlgo Orange White Theme' => gray
    'DEX Deep' => #ff009a
    'Deep Sea' => gray
    => white
color col_poc = switch color_theme
    'Spartan Edge Theme' => white
    'MountAlgo Themes' => white
    'MountAlgo Neon' => white
    'MountAlgo Frost' => white
    'MountAlgo Cyber' => white
    'Standard Spartan Edge Theme' => white
    'Dark ICT Theme' => white
    'Garuda Gold' => white
    'MountAlgo Super Premium Theme' => white
    'MountAlgo Orange White Theme' => white
    'DEX Deep' => white
    'Deep Sea' => white
    => white

color transparent_col = color.new(dark, 100)

// Liquidity Heatmap Settings
bool   auto_mode        = input.bool(true, "Auto Mode (Dynamic Step)", group=grp_liq)
bool   show_liq_heatmap = input.bool(true, "Show Liquidity Heatmap", group=grp_liq)
int    liq_opacity      = input.int(80, "Heatmap Opacity (%)", minval=0, maxval=100, step=5, group=grp_liq)
string liq_method       = input.string("Multi-Pivot + Base", "Liquidity Method", options=["Multi-Pivot + Base", "Pivots Only", "Accumulation Base Only"], group=grp_liq)
int    liq_length       = input.int(3, "Short Pivot Lookback", minval=1, group=grp_liq)
int    liq_length_long  = input.int(10, "Long Pivot Lookback", minval=2, group=grp_liq)
float  heatmap_sens     = input.float(0.1, "Heatmap Price Step (%)", minval=0.01, step=0.01, group=grp_liq)
float  maint_margin     = input.float(0.5, "Maintenance Margin (%)", minval=0.0, maxval=5.0, step=0.1, group=grp_liq) / 100

// Multi-Tier Leverage Multipliers
bool  use_lev_10  = input.bool(true, "Enable 10x Leverage", group=grp_liq)
bool  use_lev_25  = input.bool(true, "Enable 25x Leverage", group=grp_liq)
bool  use_lev_50  = input.bool(true, "Enable 50x Leverage", group=grp_liq)
bool  use_lev_75  = input.bool(true, "Enable 75x Leverage", group=grp_liq)
bool  use_lev_100 = input.bool(true, "Enable 100x Leverage", group=grp_liq)

// DOM Profile (Right Candle) Settings
bool   show_dom_profile = input.bool(true, "Show DOM Profile (Next to Candle)", group=grp_dom)
int    dom_width        = input.int(15, "DOM Profile Width (Bars)", minval=3, maxval=100, group=grp_dom)
int    dom_offset       = input.int(2, "DOM Distance from Candle (Bars)", minval=1, maxval=50, group=grp_dom)
int    dom_bins         = input.int(35, "DOM Price Level Bins", minval=10, maxval=100, group=grp_dom)
bool   show_dom_poc     = input.bool(true, "Highlight DOM Liquidity POC", group=grp_dom)
bool   show_dom_labels  = input.bool(true, "Show DOM Volume Labels", group=grp_dom)

// -----------------------------------------------------------------------------
// 2. Liquidity HEATMAP ENGINE
// -----------------------------------------------------------------------------
var array<LiqZone> liq_zones = array.new<LiqZone>()
var array<line> liq_lines_hist = array.new_line()
var array<linefill> liq_fills_hist = array.new<linefill>()

// Persistent heat grid for Smooth Background Heatmap Density (120 bins)
var float[] heat_grid = array.new_float(120, 0.0) // 60 above, 60 below
var float   heat_base_p = na

// Precision multi-lookback pivot high/low detection
float ph_short = ta.pivothigh(high, liq_length, liq_length)
float pl_short = ta.pivotlow(low, liq_length, liq_length)

float ph_long  = ta.pivothigh(high, liq_length_long, liq_length_long)
float pl_long  = ta.pivotlow(low, liq_length_long, liq_length_long)

// Equal High / Equal Low (EQH/EQL) Confluence Detection
float eqh_thresh = ta.atr(14) * 0.15
bool is_eqh = not na(ph_short) and math.abs(ph_short - ta.valuewhen(not na(ph_short), ph_short, 1)) <= eqh_thresh
bool is_eql = not na(pl_short) and math.abs(pl_short - ta.valuewhen(not na(pl_short), pl_short, 1)) <= eqh_thresh

// Relative Volume Weighting
float vol_sma = ta.sma(volume, 20)
float rel_vol = vol_sma > 0 ? math.min(3.0, math.max(0.5, volume / vol_sma)) : 1.0

// Accumulation Base Detection
[bb_mid, bb_upper, bb_lower] = ta.bb(close, liq_length_long, 2)
float bb_width = (bb_upper - bb_lower) / bb_mid
float range_atr = ta.atr(liq_length_long)
float range_high = ta.highest(high, liq_length_long)
float range_low = ta.lowest(low, liq_length_long)
float range_diff = range_high - range_low
bool is_base = range_diff < range_atr * 1.2 and bb_width < ta.sma(bb_width, liq_length_long * 2)

float base_sum_pv = 0.0
float base_sum_v = 0.0
for i = 0 to liq_length_long - 1
    float p = (high[i] + low[i] + close[i]) / 3
    float v = volume[i]
    base_sum_pv += p * v
    base_sum_v += v
float base_vwap = base_sum_v > 0 ? base_sum_pv / base_sum_v : (range_high + range_low) / 2

// Grid Step Calculation
float atr_step = ta.atr(14) * 0.25
float auto_sens = (atr_step / close) * 100
float final_sens = auto_mode ? math.max(0.01, auto_sens) : heatmap_sens
float liq_step = (close * final_sens / 100)
float inv_liq_step = liq_step > 0 ? 1.0 / liq_step : 0.0

// Initialize or smoothly adjust heat grid base
if na(heat_base_p)
    heat_base_p := math.round(close * inv_liq_step) * liq_step
    array.fill(heat_grid, 0.0)

update_heat(float target_p, float amount) =>
    if inv_liq_step > 0 and not na(heat_base_p)
        int idx = math.round((target_p - heat_base_p) * inv_liq_step) + 60
        if idx >= 0 and idx < 120
            array.set(heat_grid, idx, array.get(heat_grid, idx) + amount)

// Dynamic Theme-Integrated Gradient Mapping
get_liquidity_heat_color(float val, color t_col, bool is_core) =>
    color c_low  = color.from_gradient(25, 0, 100, dark, t_col)
    color c_mid  = t_col
    color c_high = col_poc

    color res = val <= 10.0 ? color.from_gradient(val, 1.0, 10.0, c_low, c_mid) : color.from_gradient(val, 10.0, 20.0, c_mid, c_high)

    float norm_v = math.min(1.0, val / 20.0)
    float q_weight = math.pow(norm_v, 0.6)
    int base_alpha = is_core ? math.round((1.0 - q_weight) * 15) : math.round((1.0 - q_weight) * 45 + 5)
    int final_transp = math.round(100 - (100 - base_alpha) * (liq_opacity / 100.0))
    color.new(res, math.min(100, math.max(0, final_transp)))

get_heatmap_color(float s, bool is_long, float level, bool is_core) =>
    float val = math.min(s, 20.0)
    color t_col = is_long ? col_bull : col_bear
    get_liquidity_heat_color(val, t_col, is_core)

add_or_update_liq(float raw_price, bool is_long, int bar_idx, float weight) =>
    float grid_price = math.round(raw_price * inv_liq_step) * liq_step
    update_heat(grid_price, weight * 1.5)
    bool found = false
    int sz_liq = array.size(liq_zones)
    if sz_liq > 0
        for i = 0 to sz_liq - 1
            LiqZone z = array.get(liq_zones, i)
            if z.active and z.is_long_liq == is_long and math.abs(z.level - grid_price) < (z.step * 0.75)
                z.strength += weight
                color c_edge = get_heatmap_color(z.strength, is_long, z.level, false)
                color c_core = get_heatmap_color(z.strength, is_long, z.level, true)
                if line.get_x1(z.t_ln) == bar_index
                    linefill.set_color(z.f_top, c_edge)
                    linefill.set_color(z.f_bot, c_core)
                else
                    line.set_x2(z.t_ln, bar_index)
                    line.set_x2(z.m_ln, bar_index)
                    line.set_x2(z.b_ln, bar_index)
                    array.push(liq_lines_hist, z.t_ln)
                    array.push(liq_lines_hist, z.m_ln)
                    array.push(liq_lines_hist, z.b_ln)
                    array.push(liq_fills_hist, z.f_top)
                    array.push(liq_fills_hist, z.f_bot)
                    
                    z.t_ln := line.new(bar_index, z.level + z.step/2, bar_index + 10, z.level + z.step/2, color=na, width=1)
                    z.m_ln := line.new(bar_index, z.level, bar_index + 10, z.level, color=na, width=1)
                    z.b_ln := line.new(bar_index, z.level - z.step/2, bar_index + 10, z.level - z.step/2, color=na, width=1)
                    z.f_top := linefill.new(z.t_ln, z.m_ln, color=c_edge)
                    z.f_bot := linefill.new(z.m_ln, z.b_ln, color=c_core)
                found := true
                break
    if not found
        color c_edge = get_heatmap_color(weight, is_long, grid_price, false)
        color c_core = get_heatmap_color(weight, is_long, grid_price, true)
        l_t = line.new(bar_idx, grid_price + liq_step/2, bar_index + 10, grid_price + liq_step/2, color=na, width=1)
        l_m = line.new(bar_idx, grid_price, bar_index + 10, grid_price, color=na, width=1)
        l_b = line.new(bar_idx, grid_price - liq_step/2, bar_index + 10, grid_price - liq_step/2, color=na, width=1)
        f_top = linefill.new(l_t, l_m, color=c_edge)
        f_bot = linefill.new(l_m, l_b, color=c_core)
        array.push(liq_zones, LiqZone.new(l_t, l_m, l_b, f_top, f_bot, grid_price, liq_step, weight, is_long, true))

// Fire levels on liquidity detection
if show_liq_heatmap
    bool calc_pivots = liq_method == "Multi-Pivot + Base" or liq_method == "Pivots Only"
    bool calc_base   = liq_method == "Multi-Pivot + Base" or liq_method == "Accumulation Base Only"

    // Short-term Pivot Liquidity
    if calc_pivots and not na(ph_short)
        float w = rel_vol * (is_eqh ? 2.5 : 1.0)
        int idx = bar_index[liq_length]
        if use_lev_10
            add_or_update_liq(ph_short * (1 + 1/10.0 - maint_margin), false, idx, w * 0.8)
        if use_lev_25
            add_or_update_liq(ph_short * (1 + 1/25.0 - maint_margin), false, idx, w * 1.0)
        if use_lev_50
            add_or_update_liq(ph_short * (1 + 1/50.0 - maint_margin), false, idx, w * 1.2)
        if use_lev_75
            add_or_update_liq(ph_short * (1 + 1/75.0 - maint_margin), false, idx, w * 1.4)
        if use_lev_100
            add_or_update_liq(ph_short * (1 + 1/100.0 - maint_margin), false, idx, w * 1.5)

    if calc_pivots and not na(pl_short)
        float w = rel_vol * (is_eql ? 2.5 : 1.0)
        int idx = bar_index[liq_length]
        if use_lev_10
            add_or_update_liq(pl_short * (1 - 1/10.0 + maint_margin), true, idx, w * 0.8)
        if use_lev_25
            add_or_update_liq(pl_short * (1 - 1/25.0 + maint_margin), true, idx, w * 1.0)
        if use_lev_50
            add_or_update_liq(pl_short * (1 - 1/50.0 + maint_margin), true, idx, w * 1.2)
        if use_lev_75
            add_or_update_liq(pl_short * (1 - 1/75.0 + maint_margin), true, idx, w * 1.4)
        if use_lev_100
            add_or_update_liq(pl_short * (1 - 1/100.0 + maint_margin), true, idx, w * 1.5)

    // Major Long-term Pivot Liquidity (Higher Weight)
    if calc_pivots and not na(ph_long)
        float w = rel_vol * 2.0
        int idx = bar_index[liq_length_long]
        if use_lev_10
            add_or_update_liq(ph_long * (1 + 1/10.0 - maint_margin), false, idx, w)
        if use_lev_25
            add_or_update_liq(ph_long * (1 + 1/25.0 - maint_margin), false, idx, w * 1.2)
        if use_lev_50
            add_or_update_liq(ph_long * (1 + 1/50.0 - maint_margin), false, idx, w * 1.5)

    if calc_pivots and not na(pl_long)
        float w = rel_vol * 2.0
        int idx = bar_index[liq_length_long]
        if use_lev_10
            add_or_update_liq(pl_long * (1 - 1/10.0 + maint_margin), true, idx, w)
        if use_lev_25
            add_or_update_liq(pl_long * (1 - 1/25.0 + maint_margin), true, idx, w * 1.2)
        if use_lev_50
            add_or_update_liq(pl_long * (1 - 1/50.0 + maint_margin), true, idx, w * 1.5)

    // Accumulation Base Liquidity
    if calc_base and is_base and bar_index % 5 == 0
        if use_lev_25
            add_or_update_liq(base_vwap * (1 + 1/25.0 - maint_margin), false, bar_index, 0.7)
            add_or_update_liq(base_vwap * (1 - 1/25.0 + maint_margin), true, bar_index, 0.7)
        if use_lev_50
            add_or_update_liq(base_vwap * (1 + 1/50.0 - maint_margin), false, bar_index, 0.8)
            add_or_update_liq(base_vwap * (1 - 1/50.0 + maint_margin), true, bar_index, 0.8)
        
    int sz_liq_z = array.size(liq_zones)
    if sz_liq_z > 0
        for i = sz_liq_z - 1 to 0
            LiqZone z = array.get(liq_zones, i)
            bool remove = false
            if z.active
                line.set_x2(z.t_ln, bar_index + 10)
                line.set_x2(z.m_ln, bar_index + 10)
                line.set_x2(z.b_ln, bar_index + 10)
                linefill.set_color(z.f_top, get_heatmap_color(z.strength, z.is_long_liq, z.level, false))
                linefill.set_color(z.f_bot, get_heatmap_color(z.strength, z.is_long_liq, z.level, true))
                
                bool swept = z.is_long_liq ? low <= (z.level + z.step * 0.1) : high >= (z.level - z.step * 0.1)
                if swept and bar_index > line.get_x1(z.t_ln)
                    line.set_x2(z.t_ln, bar_index)
                    line.set_x2(z.m_ln, bar_index)
                    line.set_x2(z.b_ln, bar_index)
                    z.active := false
                    array.push(liq_lines_hist, z.t_ln)
                    array.push(liq_lines_hist, z.m_ln)
                    array.push(liq_lines_hist, z.b_ln)
                    array.push(liq_fills_hist, z.f_top)
                    array.push(liq_fills_hist, z.f_bot)
                    remove := true
            
            if not remove and line.get_x1(z.t_ln) < bar_index - 300
                line.delete(z.t_ln)
                line.delete(z.m_ln)
                line.delete(z.b_ln)
                remove := true
            
            if remove
                array.remove(liq_zones, i)
    if array.size(liq_lines_hist) > 0
        for i = array.size(liq_lines_hist) - 1 to 0
            ln = array.get(liq_lines_hist, i)
            if line.get_x1(ln) < bar_index - 500
                line.delete(ln)
                array.remove(liq_lines_hist, i)
    if array.size(liq_fills_hist) > 500
        linefill.delete(array.shift(liq_fills_hist))

// Heat Decay & Sweeping
for i = 0 to 119
    float cur_heat = array.get(heat_grid, i)
    if cur_heat > 0
        float p_level = heat_base_p + (i - 60) * liq_step
        bool swept = (i >= 60 and high >= p_level) or (i < 60 and low <= p_level)
        if swept
            array.set(heat_grid, i, cur_heat * 0.2)
        else
            array.set(heat_grid, i, cur_heat * 0.999)

// Institutional Smooth Gradient Mapping
get_smooth_heat_color(float heat, bool is_above, float level) =>
    float val = math.min(heat, 20.0)
    color t_col = is_above ? col_bear : col_bull
    get_liquidity_heat_color(val, t_col, true)

// High-density Full-Chart Background Plot Grid Rendering
show_plots_liq = show_liq_heatmap

p_u00 = plot(show_plots_liq ? heat_base_p + 0 * liq_step : na, "H+0", color=transparent_col, style=plot.style_linebr)
p_u04 = plot(show_plots_liq ? heat_base_p + 4 * liq_step : na, "H+4", color=transparent_col, style=plot.style_linebr)
p_u08 = plot(show_plots_liq ? heat_base_p + 8 * liq_step : na, "H+8", color=transparent_col, style=plot.style_linebr)
p_u12 = plot(show_plots_liq ? heat_base_p + 12 * liq_step : na, "H+12", color=transparent_col, style=plot.style_linebr)
p_u16 = plot(show_plots_liq ? heat_base_p + 16 * liq_step : na, "H+16", color=transparent_col, style=plot.style_linebr)
p_u24 = plot(show_plots_liq ? heat_base_p + 24 * liq_step : na, "H+24", color=transparent_col, style=plot.style_linebr)
p_u32 = plot(show_plots_liq ? heat_base_p + 32 * liq_step : na, "H+32", color=transparent_col, style=plot.style_linebr)
p_u48 = plot(show_plots_liq ? heat_base_p + 48 * liq_step : na, "H+48", color=transparent_col, style=plot.style_linebr)

fill(p_u00, p_u04, color=get_smooth_heat_color(array.get(heat_grid, 62), true, heat_base_p + 2 * liq_step))
fill(p_u04, p_u08, color=get_smooth_heat_color(array.get(heat_grid, 66), true, heat_base_p + 6 * liq_step))
fill(p_u08, p_u12, color=get_smooth_heat_color(array.get(heat_grid, 70), true, heat_base_p + 10 * liq_step))
fill(p_u12, p_u16, color=get_smooth_heat_color(array.get(heat_grid, 74), true, heat_base_p + 14 * liq_step))
fill(p_u16, p_u24, color=get_smooth_heat_color(array.get(heat_grid, 80), true, heat_base_p + 20 * liq_step))
fill(p_u24, p_u32, color=get_smooth_heat_color(array.get(heat_grid, 88), true, heat_base_p + 28 * liq_step))
fill(p_u32, p_u48, color=get_smooth_heat_color(array.get(heat_grid, 100), true, heat_base_p + 40 * liq_step))

p_d00 = plot(show_plots_liq ? heat_base_p - 0 * liq_step : na, "H-0", color=transparent_col, style=plot.style_linebr)
p_d04 = plot(show_plots_liq ? heat_base_p - 4 * liq_step : na, "H-4", color=transparent_col, style=plot.style_linebr)
p_d08 = plot(show_plots_liq ? heat_base_p - 8 * liq_step : na, "H-8", color=transparent_col, style=plot.style_linebr)
p_d12 = plot(show_plots_liq ? heat_base_p - 12 * liq_step : na, "H-12", color=transparent_col, style=plot.style_linebr)
p_d16 = plot(show_plots_liq ? heat_base_p - 16 * liq_step : na, "H-16", color=transparent_col, style=plot.style_linebr)
p_d24 = plot(show_plots_liq ? heat_base_p - 24 * liq_step : na, "H-24", color=transparent_col, style=plot.style_linebr)
p_d32 = plot(show_plots_liq ? heat_base_p - 32 * liq_step : na, "H-32", color=transparent_col, style=plot.style_linebr)
p_d48 = plot(show_plots_liq ? heat_base_p - 48 * liq_step : na, "H-48", color=transparent_col, style=plot.style_linebr)

fill(p_d00, p_d04, color=get_smooth_heat_color(array.get(heat_grid, 58), false, heat_base_p - 2 * liq_step))
fill(p_d04, p_d08, color=get_smooth_heat_color(array.get(heat_grid, 54), false, heat_base_p - 6 * liq_step))
fill(p_d08, p_d12, color=get_smooth_heat_color(array.get(heat_grid, 50), false, heat_base_p - 10 * liq_step))
fill(p_d12, p_d16, color=get_smooth_heat_color(array.get(heat_grid, 46), false, heat_base_p - 14 * liq_step))
fill(p_d16, p_d24, color=get_smooth_heat_color(array.get(heat_grid, 40), false, heat_base_p - 20 * liq_step))
fill(p_d24, p_d32, color=get_smooth_heat_color(array.get(heat_grid, 32), false, heat_base_p - 28 * liq_step))
fill(p_d32, p_d48, color=get_smooth_heat_color(array.get(heat_grid, 20), false, heat_base_p - 40 * liq_step))

// -----------------------------------------------------------------------------
// 3. DOM LIQUIDITY PROFILE ENGINE (RIGHT CANDLE ATTACHED)
// -----------------------------------------------------------------------------
var box[]   dom_boxes  = array.new_box()
var line[]  dom_lines  = array.new_line()
var label[] dom_labels = array.new_label()

format_liq_val(float v) =>
    string res = ""
    if v >= 1000000
        res := str.tostring(v / 1000000, "#.##") + "M"
    else if v >= 1000
        res := str.tostring(v / 1000, "#.#") + "K"
    else
        res := str.tostring(v, "#.#")
    res

if barstate.islast
    // Clear previous DOM drawings on last bar update
    if array.size(dom_boxes) > 0
        for i = 0 to array.size(dom_boxes) - 1
            box.delete(array.get(dom_boxes, i))
        array.clear(dom_boxes)
    if array.size(dom_lines) > 0
        for i = 0 to array.size(dom_lines) - 1
            line.delete(array.get(dom_lines, i))
        array.clear(dom_lines)
    if array.size(dom_labels) > 0
        for i = 0 to array.size(dom_labels) - 1
            label.delete(array.get(dom_labels, i))
        array.clear(dom_labels)

    if show_dom_profile
        // Determine price range for DOM aggregation
        float dom_high = high + ta.atr(14) * 4
        float dom_low  = low - ta.atr(14) * 4

        int sz_z = array.size(liq_zones)
        if sz_z > 0
            for i = 0 to sz_z - 1
                LiqZone z = array.get(liq_zones, i)
                if z.active
                    if z.level + z.step > dom_high
                        dom_high := z.level + z.step
                    if z.level - z.step < dom_low
                        dom_low := z.level - z.step

        float dom_range = dom_high - dom_low
        int n_bins = math.max(10, dom_bins)
        float bin_h = dom_range / n_bins

        if bin_h > 0
            float inv_bin_h = 1.0 / bin_h
            float[] bin_liq_long  = array.new_float(n_bins, 0.0)
            float[] bin_liq_short = array.new_float(n_bins, 0.0)

            // Aggregate liquidity from active Liquidity Zones
            if sz_z > 0
                for i = 0 to sz_z - 1
                    LiqZone z = array.get(liq_zones, i)
                    if z.active and z.level >= dom_low and z.level <= dom_high
                        int b_idx = math.min(n_bins - 1, math.max(0, math.floor((z.level - dom_low) * inv_bin_h)))
                        if z.is_long_liq
                            array.set(bin_liq_long, b_idx, array.get(bin_liq_long, b_idx) + z.strength)
                        else
                            array.set(bin_liq_short, b_idx, array.get(bin_liq_short, b_idx) + z.strength)

            // Aggregate heat_grid density
            for i = 0 to 119
                float h_val = array.get(heat_grid, i)
                if h_val > 0
                    float p_lvl = heat_base_p + (i - 60) * liq_step
                    if p_lvl >= dom_low and p_lvl <= dom_high
                        int b_idx = math.min(n_bins - 1, math.max(0, math.floor((p_lvl - dom_low) * inv_bin_h)))
                        if p_lvl < close
                            array.set(bin_liq_long, b_idx, array.get(bin_liq_long, b_idx) + h_val)
                        else
                            array.set(bin_liq_short, b_idx, array.get(bin_liq_short, b_idx) + h_val)

            // Aggregate multi-leveraged positions calculated from recent pivot highs/lows for full depth completeness
            float p_h_s = ta.valuewhen(not na(ph_short), ph_short, 0)
            float p_l_s = ta.valuewhen(not na(pl_short), pl_short, 0)
            if not na(p_h_s)
                float[] h_levels = array.new_float(5)
                array.set(h_levels, 0, p_h_s * (1 + 1/10.0 - maint_margin))
                array.set(h_levels, 1, p_h_s * (1 + 1/25.0 - maint_margin))
                array.set(h_levels, 2, p_h_s * (1 + 1/50.0 - maint_margin))
                array.set(h_levels, 3, p_h_s * (1 + 1/75.0 - maint_margin))
                array.set(h_levels, 4, p_h_s * (1 + 1/100.0 - maint_margin))
                for idx = 0 to 4
                    float lvl = array.get(h_levels, idx)
                    if lvl >= dom_low and lvl <= dom_high
                        int b_idx = math.min(n_bins - 1, math.max(0, math.floor((lvl - dom_low) * inv_bin_h)))
                        array.set(bin_liq_short, b_idx, array.get(bin_liq_short, b_idx) + rel_vol * 2.0)

            if not na(p_l_s)
                float[] l_levels = array.new_float(5)
                array.set(l_levels, 0, p_l_s * (1 - 1/10.0 + maint_margin))
                array.set(l_levels, 1, p_l_s * (1 - 1/25.0 + maint_margin))
                array.set(l_levels, 2, p_l_s * (1 - 1/50.0 + maint_margin))
                array.set(l_levels, 3, p_l_s * (1 - 1/75.0 + maint_margin))
                array.set(l_levels, 4, p_l_s * (1 - 1/100.0 + maint_margin))
                for idx = 0 to 4
                    float lvl = array.get(l_levels, idx)
                    if lvl >= dom_low and lvl <= dom_high
                        int b_idx = math.min(n_bins - 1, math.max(0, math.floor((lvl - dom_low) * inv_bin_h)))
                        array.set(bin_liq_long, b_idx, array.get(bin_liq_long, b_idx) + rel_vol * 2.0)

            // Find Maximum DOM Liquidity and POC Level
            float max_bin_liq = 0.0
            int dom_poc_idx = 0
            for b = 0 to n_bins - 1
                float tot_b = array.get(bin_liq_long, b) + array.get(bin_liq_short, b)
                if tot_b > max_bin_liq
                    max_bin_liq := tot_b
                    dom_poc_idx := b

            float inv_max_bin = max_bin_liq > 0 ? 1.0 / max_bin_liq : 1.0

            // Position DOM profile right next to the current candle (bar_index + dom_offset)
            int dom_x_start = bar_index + dom_offset
            int dom_x_max   = dom_x_start + dom_width

            // Render Vertical DOM Spine next to candle
            line l_spine = line.new(dom_x_start, dom_low, dom_x_start, dom_high, color=col_poc, width=1, style=line.style_dotted)
            array.push(dom_lines, l_spine)

            // Render DOM Histogram Bins
            for b = 0 to n_bins - 1
                float l_long  = array.get(bin_liq_long, b)
                float l_short = array.get(bin_liq_short, b)
                float l_tot   = l_long + l_short

                if l_tot > 0
                    float y_bot = dom_low + b * bin_h
                    float y_top = y_bot + bin_h
                    float norm_len = (l_tot * inv_max_bin) * dom_width
                    int x_end = dom_x_start + math.max(1, math.round(norm_len))

                    bool is_long_dominant = l_long >= l_short
                    color base_dom_c = is_long_dominant ? col_bull : col_bear
                    int dom_transp   = math.round(75 - (l_tot * inv_max_bin) * 55)
                    color fill_dom_c = color.new(base_dom_c, math.max(10, math.min(85, dom_transp)))

                    string label_text = show_dom_labels and norm_len > 2 ? format_liq_val(l_tot) : ""

                    box bx = box.new(dom_x_start, y_top, x_end, y_bot,
                                     border_color=color.new(base_dom_c, 40),
                                     border_width=1,
                                     bgcolor=fill_dom_c,
                                     text=label_text,
                                     text_color=col_poc,
                                     text_size=size.tiny,
                                     text_valign=text.align_center,
                                     text_halign=text.align_left)
                    array.push(dom_boxes, bx)

            // Highlight DOM Liquidity POC Line & Label
            if show_dom_poc and max_bin_liq > 0
                float dom_poc_p = dom_low + dom_poc_idx * bin_h + bin_h / 2
                line l_poc = line.new(dom_x_start, dom_poc_p, dom_x_max + 3, dom_poc_p, color=col_poc, width=2, style=line.style_solid)
                array.push(dom_lines, l_poc)

                string poc_txt = "LQ POC: " + str.tostring(dom_poc_p, format.mintick) + " (" + format_liq_val(max_bin_liq) + ")"
                label lbl_poc = label.new(dom_x_max + 4, dom_poc_p, poc_txt, color=color.new(dark, 50), textcolor=col_poc, style=label.style_label_left, size=size.tiny)
                array.push(dom_labels, lbl_poc)
