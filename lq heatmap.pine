//@version=6
indicator("Liquidity Heatmap V4 𝙈𝙤𝙪𝙣𝙩𝘼𝙡𝙜𝙤", shorttitle="LQ Heatmap V4 𝙈𝙤𝙪𝙣𝙩𝘼𝙡𝙜𝙤", overlay=true, max_lines_count=500, max_boxes_count=500, max_bars_back=2000)

// -----------------------------------------------------------------------------
// 0. USER DEFINED TYPES
// -----------------------------------------------------------------------------
type LiqZone
    line ln
    float level
    float step
    float strength
    bool is_long_liq
    bool active

// -----------------------------------------------------------------------------
// 1. INPUTS & CONFIGURATION
// -----------------------------------------------------------------------------
string GlobalGroup = "Visual Themes & Global"
string grp_liq     = "Liquidity Levels & Heatmap Engine"

// --- THEME SYSTEM ---
string color_theme = input.string(defval = 'DEX Deep', title = 'Select Color Theme', options = ['Spartan Edge Theme', 'MountAlgo Themes', 'MountAlgo Neon', 'MountAlgo Frost', 'MountAlgo Cyber', 'Standard Spartan Edge Theme', 'Dark ICT Theme', 'Charts Desk', 'Garuda Gold', 'MountAlgo Super Premium Theme', 'MountAlgo Orange White Theme', 'DEX Deep', 'Deep Sea'], group=GlobalGroup)

// Colors
color dark   = #000000
color white  = #ffffff
color green  = #00e676
color purple = #7c4dff
color gray   = #78909c
color red    = #ff1744
color yellow = #ffd600
color orange = #ff9100
color blue   = #2979ff

color col_bull = switch color_theme
    'Spartan Edge Theme' => red
    'MountAlgo Themes' => purple
    'MountAlgo Neon' => #7c4dff
    'MountAlgo Frost' => #00e5ff
    'MountAlgo Cyber' => #2979ff
    'Standard Spartan Edge Theme' => green
    'Dark ICT Theme' => green
    'Charts Desk' => #a1ff3b
    'Garuda Gold' => yellow
    'MountAlgo Super Premium Theme' => purple
    'MountAlgo Orange White Theme' => orange
    'DEX Deep' => #a1ff3b
    'Deep Sea' => blue
    => blue

color col_bear = switch color_theme
    'Spartan Edge Theme' => gray
    'MountAlgo Themes' => green
    'MountAlgo Neon' => #ff007f
    'MountAlgo Frost' => #ff0055
    'MountAlgo Cyber' => #ff007f
    'Standard Spartan Edge Theme' => red
    'Dark ICT Theme' => gray
    'Charts Desk' => gray
    'Garuda Gold' => gray
    'MountAlgo Super Premium Theme' => yellow
    'MountAlgo Orange White Theme' => gray
    'DEX Deep' => #ff007f
    'Deep Sea' => gray
    => white

color col_poc = switch color_theme
    'Spartan Edge Theme' => white
    'MountAlgo Themes' => white
    'MountAlgo Neon' => white
    'MountAlgo Frost' => white
    'MountAlgo Cyber' => white
    'Standard Spartan Edge Theme' => white
    'Dark ICT Theme' => white
    'Charts Desk' => white
    'Garuda Gold' => white
    'MountAlgo Super Premium Theme' => white
    'MountAlgo Orange White Theme' => white
    'DEX Deep' => white
    'Deep Sea' => white
    => white

color transparent_col = color.new(dark, 100)

// Liquidity Heatmap Settings
bool   auto_mode        = input.bool(true, "Auto Mode (Dynamic Step)", group=grp_liq)
bool   show_liq_heatmap = input.bool(true, "Show Liquidity Heatmap Levels", group=grp_liq)
int    liq_opacity      = input.int(90, "Heatmap Visibility/Intensity (%)", minval=0, maxval=100, step=5, group=grp_liq)
string liq_method       = input.string("Multi-Pivot + Base", "Liquidity Method", options=["Multi-Pivot + Base", "Pivots Only", "Accumulation Base Only"], group=grp_liq)
int    liq_length       = input.int(3, "Short Pivot Lookback", minval=1, group=grp_liq)
int    liq_length_long  = input.int(10, "Long Pivot Lookback", minval=2, group=grp_liq)
float  heatmap_sens     = input.float(0.05, "Heatmap Price Step (%)", minval=0.005, step=0.005, group=grp_liq)
float  maint_margin     = input.float(0.5, "Maintenance Margin (%)", minval=0.0, maxval=5.0, step=0.1, group=grp_liq) / 100

// Multi-Tier Leverage Multipliers
bool  use_lev_10  = input.bool(true, "Enable 10x Leverage", group=grp_liq)
bool  use_lev_25  = input.bool(true, "Enable 25x Leverage", group=grp_liq)
bool  use_lev_50  = input.bool(true, "Enable 50x Leverage", group=grp_liq)
bool  use_lev_75  = input.bool(true, "Enable 75x Leverage", group=grp_liq)
bool  use_lev_100 = input.bool(true, "Enable 100x Leverage", group=grp_liq)


// -----------------------------------------------------------------------------
// 2. Liquidity HEATMAP ENGINE
// -----------------------------------------------------------------------------
var array<LiqZone> liq_zones = array.new<LiqZone>()
var array<line> liq_lines_hist = array.new_line()

// Persistent heat grid for Smooth Background Heatmap Density (120 bins)
var float[] heat_grid = array.new_float(120, 0.0) // 60 above, 60 below
var float   heat_base_p = na

// Precision multi-lookback pivot high/low detection
float ph_short = ta.pivothigh(high, liq_length, liq_length)
float pl_short = ta.pivotlow(low, liq_length, liq_length)

float ph_long  = ta.pivothigh(high, liq_length_long, liq_length_long)
float pl_long  = ta.pivotlow(low, liq_length_long, liq_length_long)

// Equal High / Equal Low (EQH/EQL) Confluence Detection
float eqh_thresh = ta.atr(14) * 0.15
float prev_ph_short = ta.valuewhen(not na(ph_short), ph_short, 1)
float prev_pl_short = ta.valuewhen(not na(pl_short), pl_short, 1)
bool is_eqh = not na(ph_short) and math.abs(ph_short - prev_ph_short) <= eqh_thresh
bool is_eql = not na(pl_short) and math.abs(pl_short - prev_pl_short) <= eqh_thresh

// Relative Volume Weighting
float vol_sma = ta.sma(volume, 20)
float rel_vol = vol_sma > 0 ? math.min(3.0, math.max(0.5, volume / vol_sma)) : 1.0

// Accumulation Base Detection
[bb_mid, bb_upper, bb_lower] = ta.bb(close, liq_length_long, 2)
float bb_width = (bb_upper - bb_lower) / bb_mid
float bb_width_sma = ta.sma(bb_width, liq_length_long * 2)
float range_atr = ta.atr(liq_length_long)
float range_high = ta.highest(high, liq_length_long)
float range_low = ta.lowest(low, liq_length_long)
float range_diff = range_high - range_low
bool is_base = range_diff < range_atr * 1.2 and bb_width < bb_width_sma

float base_vwap = (range_high + range_low) / 2

// Compact Grid Step Calculation for Super Precision
float atr_step = ta.atr(14) * 0.08
float auto_sens = (atr_step / close) * 100
float final_sens = auto_mode ? math.max(0.005, auto_sens) : heatmap_sens
float liq_step = (close * final_sens / 100)
float inv_liq_step = liq_step > 0 ? 1.0 / liq_step : 0.0

// Initialize or shift heat grid base
if na(heat_base_p) or math.abs(close - heat_base_p) > liq_step * 20
    heat_base_p := math.round(close * inv_liq_step) * liq_step
    array.fill(heat_grid, 0.0)

update_heat(float target_p, float amount) =>
    if inv_liq_step > 0
        int idx = math.round((target_p - heat_base_p) * inv_liq_step) + 60
        if idx >= 0 and idx < 120
            array.set(heat_grid, idx, array.get(heat_grid, idx) + amount)

// High-Contrast Multi-Stage Thermal Gradient Mapping
get_high_contrast_heat_color(float s_val, color base_theme_col, float proximity_factor) =>
    float norm_s = math.max(0.0, math.min(1.0, s_val / 12.0))

    // Tiered color spectrum for extreme visual distinction:
    // Low liquidity: Muted dark tone of theme color
    // Med liquidity: Pure vivid theme color
    // High liquidity: Hot yellow / bright orange highlight
    // Max liquidity / Hotspot: Brilliant White
    color c_low  = color.from_gradient(50, 0, 100, dark, base_theme_col)
    color c_mid  = base_theme_col
    color c_high = orange
    color c_max  = white

    color base_res = color.black
    if norm_s <= 0.33
        base_res := color.from_gradient(norm_s * 3.0, 0.0, 1.0, c_low, c_mid)
    else if norm_s <= 0.75
        base_res := color.from_gradient((norm_s - 0.33) / 0.42, 0.0, 1.0, c_mid, c_high)
    else
        base_res := color.from_gradient((norm_s - 0.75) / 0.25, 0.0, 1.0, c_high, c_max)

    // Dynamic transparency calculation: higher strength = crisper & more opaque line
    int base_transp = math.round(70.0 - norm_s * 60.0)
    int prox_transp_boost = math.round(proximity_factor * 15.0)
    int final_transp = math.max(0, math.min(95, base_transp - prox_transp_boost))

    // Scale by user opacity setting
    int adjusted_transp = math.round(100 - (100 - final_transp) * (liq_opacity / 100.0))
    color.new(base_res, adjusted_transp)

get_heatmap_color(float s, bool is_long, float level, float current_close, float current_atr) =>
    float dist = math.abs(level - current_close)
    float atr_ref = current_atr > 0 ? current_atr : 1.0
    float proximity_factor = math.max(0.0, math.min(1.0, 1.0 - (dist / (atr_ref * 5.0))))
    color t_col = is_long ? col_bull : col_bear
    get_high_contrast_heat_color(s, t_col, proximity_factor)

add_or_update_liq(float raw_price, bool is_long, int bar_idx, float weight, float current_atr) =>
    float grid_price = math.round(raw_price * inv_liq_step) * liq_step
    update_heat(grid_price, weight * 1.5)
    bool found = false
    int sz_liq = array.size(liq_zones)
    if sz_liq > 0
        for i = 0 to sz_liq - 1
            LiqZone z = array.get(liq_zones, i)
            if z.active and z.is_long_liq == is_long and math.abs(z.level - grid_price) < (z.step * 0.75)
                z.strength += weight
                color c_line = get_heatmap_color(z.strength, is_long, z.level, close, current_atr)
                int l_width = z.strength >= 8.0 ? 3 : (z.strength >= 3.5 ? 2 : 1)
                if line.get_x1(z.ln) == bar_index
                    line.set_color(z.ln, c_line)
                    line.set_width(z.ln, l_width)
                else
                    line.set_x2(z.ln, bar_index)
                    array.push(liq_lines_hist, z.ln)
                    
                    z.ln := line.new(bar_index, z.level, bar_index + 10, z.level, color=c_line, width=l_width)
                found := true
                break
    if not found
        color c_line = get_heatmap_color(weight, is_long, grid_price, close, current_atr)
        int l_width = weight >= 8.0 ? 3 : (weight >= 3.5 ? 2 : 1)
        l_main = line.new(bar_idx, grid_price, bar_index + 10, grid_price, color=c_line, width=l_width)
        array.push(liq_zones, LiqZone.new(l_main, grid_price, liq_step, weight, is_long, true))

// Fire levels on liquidity detection
if show_liq_heatmap
    bool calc_pivots = liq_method == "Multi-Pivot + Base" or liq_method == "Pivots Only"
    bool calc_base   = liq_method == "Multi-Pivot + Base" or liq_method == "Accumulation Base Only"

    // Short-term Pivot Liquidity
    if calc_pivots and not na(ph_short)
        float w = rel_vol * (is_eqh ? 2.5 : 1.0)
        int idx = bar_index[liq_length]
        if use_lev_10
            add_or_update_liq(ph_short * (1 + 1/10.0 - maint_margin), false, idx, w * 0.8, range_atr)
        if use_lev_25
            add_or_update_liq(ph_short * (1 + 1/25.0 - maint_margin), false, idx, w * 1.0, range_atr)
        if use_lev_50
            add_or_update_liq(ph_short * (1 + 1/50.0 - maint_margin), false, idx, w * 1.2, range_atr)
        if use_lev_75
            add_or_update_liq(ph_short * (1 + 1/75.0 - maint_margin), false, idx, w * 1.4, range_atr)
        if use_lev_100
            add_or_update_liq(ph_short * (1 + 1/100.0 - maint_margin), false, idx, w * 1.5, range_atr)

    if calc_pivots and not na(pl_short)
        float w = rel_vol * (is_eql ? 2.5 : 1.0)
        int idx = bar_index[liq_length]
        if use_lev_10
            add_or_update_liq(pl_short * (1 - 1/10.0 + maint_margin), true, idx, w * 0.8, range_atr)
        if use_lev_25
            add_or_update_liq(pl_short * (1 - 1/25.0 + maint_margin), true, idx, w * 1.0, range_atr)
        if use_lev_50
            add_or_update_liq(pl_short * (1 - 1/50.0 + maint_margin), true, idx, w * 1.2, range_atr)
        if use_lev_75
            add_or_update_liq(pl_short * (1 - 1/75.0 + maint_margin), true, idx, w * 1.4, range_atr)
        if use_lev_100
            add_or_update_liq(pl_short * (1 - 1/100.0 + maint_margin), true, idx, w * 1.5, range_atr)

    // Major Long-term Pivot Liquidity (Higher Weight)
    if calc_pivots and not na(ph_long)
        float w = rel_vol * 2.0
        int idx = bar_index[liq_length_long]
        if use_lev_10
            add_or_update_liq(ph_long * (1 + 1/10.0 - maint_margin), false, idx, w, range_atr)
        if use_lev_25
            add_or_update_liq(ph_long * (1 + 1/25.0 - maint_margin), false, idx, w * 1.2, range_atr)
        if use_lev_50
            add_or_update_liq(ph_long * (1 + 1/50.0 - maint_margin), false, idx, w * 1.5, range_atr)

    if calc_pivots and not na(pl_long)
        float w = rel_vol * 2.0
        int idx = bar_index[liq_length_long]
        if use_lev_10
            add_or_update_liq(pl_long * (1 - 1/10.0 + maint_margin), true, idx, w, range_atr)
        if use_lev_25
            add_or_update_liq(pl_long * (1 - 1/25.0 + maint_margin), true, idx, w * 1.2, range_atr)
        if use_lev_50
            add_or_update_liq(pl_long * (1 - 1/50.0 + maint_margin), true, idx, w * 1.5, range_atr)

    // Accumulation Base Liquidity
    if calc_base and is_base and bar_index % 5 == 0
        float base_sum_pv = 0.0
        float base_sum_v = 0.0
        for i = 0 to liq_length_long - 1
            float p = (high[i] + low[i] + close[i]) / 3
            float v = volume[i]
            base_sum_pv += p * v
            base_sum_v += v
        float calc_base_vwap = base_sum_v > 0 ? base_sum_pv / base_sum_v : base_vwap

        if use_lev_25
            add_or_update_liq(calc_base_vwap * (1 + 1/25.0 - maint_margin), false, bar_index, 0.7, range_atr)
            add_or_update_liq(calc_base_vwap * (1 - 1/25.0 + maint_margin), true, bar_index, 0.7, range_atr)
        if use_lev_50
            add_or_update_liq(calc_base_vwap * (1 + 1/50.0 - maint_margin), false, bar_index, 0.8, range_atr)
            add_or_update_liq(calc_base_vwap * (1 - 1/50.0 + maint_margin), true, bar_index, 0.8, range_atr)
        
    int sz_liq_z = array.size(liq_zones)
    if sz_liq_z > 0
        bool is_last_bar = barstate.islast
        for i = sz_liq_z - 1 to 0
            LiqZone z = array.get(liq_zones, i)
            bool remove = false
            if z.active
                color c_line = get_heatmap_color(z.strength, z.is_long_liq, z.level, close, range_atr)
                int l_width = z.strength >= 8.0 ? 3 : (z.strength >= 3.5 ? 2 : 1)

                if line.get_x1(z.ln) == bar_index
                    line.set_x2(z.ln, bar_index + (is_last_bar ? 10 : 1))
                    line.set_color(z.ln, c_line)
                    line.set_width(z.ln, l_width)
                else
                    line.set_x2(z.ln, bar_index)
                    array.push(liq_lines_hist, z.ln)

                    z.ln := line.new(bar_index, z.level, bar_index + (is_last_bar ? 10 : 1), z.level, color=c_line, width=l_width)

                bool swept = z.is_long_liq ? low <= (z.level + z.step * 0.1) : high >= (z.level - z.step * 0.1)
                if swept and bar_index > line.get_x1(z.ln)
                    line.set_x2(z.ln, bar_index)
                    z.active := false
                    remove := true
            
            if not remove and line.get_x1(z.ln) < bar_index - 300
                line.delete(z.ln)
                remove := true
            
            if remove
                array.remove(liq_zones, i)

    while array.size(liq_lines_hist) > 400
        line.delete(array.shift(liq_lines_hist))

// Heat Decay & Sweeping
for i = 0 to 119
    float cur_heat = array.get(heat_grid, i)
    if cur_heat > 0
        float p_level = heat_base_p + (i - 60) * liq_step
        bool swept = (i >= 60 and high >= p_level) or (i < 60 and low <= p_level)
        if swept
            array.set(heat_grid, i, cur_heat * 0.2)
        else
            array.set(heat_grid, i, cur_heat * 0.999)

// Institutional Smooth Gradient Mapping
get_smooth_heat_color(float heat, bool is_above, float level, float current_close, float current_atr) =>
    color t_col = is_above ? col_bear : col_bull
    float dist = math.abs(level - current_close)
    float atr_ref = current_atr > 0 ? current_atr : 1.0
    float proximity_factor = math.max(0.0, math.min(1.0, 1.0 - (dist / (atr_ref * 5.0))))
    get_high_contrast_heat_color(heat, t_col, proximity_factor)

// High-density Full-Chart Background Plot Grid Rendering
show_plots_liq = show_liq_heatmap

p_u00 = plot(show_plots_liq ? heat_base_p + 0 * liq_step : na, "H+0", color=transparent_col, style=plot.style_linebr)
p_u04 = plot(show_plots_liq ? heat_base_p + 4 * liq_step : na, "H+4", color=transparent_col, style=plot.style_linebr)
p_u08 = plot(show_plots_liq ? heat_base_p + 8 * liq_step : na, "H+8", color=transparent_col, style=plot.style_linebr)
p_u12 = plot(show_plots_liq ? heat_base_p + 12 * liq_step : na, "H+12", color=transparent_col, style=plot.style_linebr)
p_u16 = plot(show_plots_liq ? heat_base_p + 16 * liq_step : na, "H+16", color=transparent_col, style=plot.style_linebr)
p_u24 = plot(show_plots_liq ? heat_base_p + 24 * liq_step : na, "H+24", color=transparent_col, style=plot.style_linebr)
p_u32 = plot(show_plots_liq ? heat_base_p + 32 * liq_step : na, "H+32", color=transparent_col, style=plot.style_linebr)
p_u48 = plot(show_plots_liq ? heat_base_p + 48 * liq_step : na, "H+48", color=transparent_col, style=plot.style_linebr)

fill(p_u00, p_u04, color=get_smooth_heat_color(array.get(heat_grid, 62), true, heat_base_p + 2 * liq_step, close, range_atr))
fill(p_u04, p_u08, color=get_smooth_heat_color(array.get(heat_grid, 66), true, heat_base_p + 6 * liq_step, close, range_atr))
fill(p_u08, p_u12, color=get_smooth_heat_color(array.get(heat_grid, 70), true, heat_base_p + 10 * liq_step, close, range_atr))
fill(p_u12, p_u16, color=get_smooth_heat_color(array.get(heat_grid, 74), true, heat_base_p + 14 * liq_step, close, range_atr))
fill(p_u16, p_u24, color=get_smooth_heat_color(array.get(heat_grid, 80), true, heat_base_p + 20 * liq_step, close, range_atr))
fill(p_u24, p_u32, color=get_smooth_heat_color(array.get(heat_grid, 88), true, heat_base_p + 28 * liq_step, close, range_atr))
fill(p_u32, p_u48, color=get_smooth_heat_color(array.get(heat_grid, 100), true, heat_base_p + 40 * liq_step, close, range_atr))

p_d00 = plot(show_plots_liq ? heat_base_p - 0 * liq_step : na, "H-0", color=transparent_col, style=plot.style_linebr)
p_d04 = plot(show_plots_liq ? heat_base_p - 4 * liq_step : na, "H-4", color=transparent_col, style=plot.style_linebr)
p_d08 = plot(show_plots_liq ? heat_base_p - 8 * liq_step : na, "H-8", color=transparent_col, style=plot.style_linebr)
p_d12 = plot(show_plots_liq ? heat_base_p - 12 * liq_step : na, "H-12", color=transparent_col, style=plot.style_linebr)
p_d16 = plot(show_plots_liq ? heat_base_p - 16 * liq_step : na, "H-16", color=transparent_col, style=plot.style_linebr)
p_d24 = plot(show_plots_liq ? heat_base_p - 24 * liq_step : na, "H-24", color=transparent_col, style=plot.style_linebr)
p_d32 = plot(show_plots_liq ? heat_base_p - 32 * liq_step : na, "H-32", color=transparent_col, style=plot.style_linebr)
p_d48 = plot(show_plots_liq ? heat_base_p - 48 * liq_step : na, "H-48", color=transparent_col, style=plot.style_linebr)

fill(p_d00, p_d04, color=get_smooth_heat_color(array.get(heat_grid, 58), false, heat_base_p - 2 * liq_step, close, range_atr))
fill(p_d04, p_d08, color=get_smooth_heat_color(array.get(heat_grid, 54), false, heat_base_p - 6 * liq_step, close, range_atr))
fill(p_d08, p_d12, color=get_smooth_heat_color(array.get(heat_grid, 50), false, heat_base_p - 10 * liq_step, close, range_atr))
fill(p_d12, p_d16, color=get_smooth_heat_color(array.get(heat_grid, 46), false, heat_base_p - 14 * liq_step, close, range_atr))
fill(p_d16, p_d24, color=get_smooth_heat_color(array.get(heat_grid, 40), false, heat_base_p - 20 * liq_step, close, range_atr))
fill(p_d24, p_d32, color=get_smooth_heat_color(array.get(heat_grid, 32), false, heat_base_p - 28 * liq_step, close, range_atr))
fill(p_d32, p_d48, color=get_smooth_heat_color(array.get(heat_grid, 20), false, heat_base_p - 40 * liq_step, close, range_atr))
