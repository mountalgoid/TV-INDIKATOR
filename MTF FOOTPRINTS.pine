GlobalGroup = 'Visual Themes & Global'
color_theme = input.string(defval = 'DEX Deep', title = 'Select Color Theme', options = ['Spartan Edge Theme', 'MountAlgo Themes', 'MountAlgo Neon', 'MountAlgo Frost', 'MountAlgo Cyber', 'Standard Spartan Edge Theme', 'Dark ICT Theme', 'Garuda Gold', 'MountAlgo Super Premium Theme', 'MountAlgo Orange White Theme', 'DEX Deep', 'Deep Sea'], group = GlobalGroup)
type_ltf_plot_candle = input.string(defval = 'Regular Candles', title = 'Type LTF Plot Candle', options = ['Regular Candles', 'Custom Candles'], group = GlobalGroup)
type_ltf_color_candle = input.string(defval = 'Based Stochastic RSI', title = 'Type LTF Color Candle', options = ['Regular Color Candles', 'Based Stochastic RSI', 'Based Delta', 'Based EMA'], group = GlobalGroup)
show_ltf_plot_candle = input.bool(defval = true, title = 'Show LTF Plot Candle', group = GlobalGroup)
show_htf_plot_candle = input.bool(defval = true, title = 'Show HTF Plot Candle', group = GlobalGroup)
ema_length = input.int(200, title="Custom EMA Length", group=GlobalGroup)

// HTF Settings
auto_htf_mode = input.bool(true, title="Auto HTF Mode", group=GlobalGroup)
manual_htf_timeframe = input.timeframe("60", title="Manual Higher TimeFrame", group=GlobalGroup)

get_auto_htf() =>
    if timeframe.isseconds
        "15"
    else if timeframe.isminutes
        int m = timeframe.multiplier
        if m <= 2
            "60"
        else if m <= 4
            "60"
        else if m <= 14
            "240"
        else if m <= 30
            "D"
        else
            "D"
    else if timeframe.isdaily
        "W"
    else
        "M"

htf_timeframe = auto_htf_mode ? get_auto_htf() : manual_htf_timeframe
show_volume_profile = input.bool(true, title="Show Volume Profile")
show_poc = input.bool(true, title="Show POC")
show_delta = input.bool(true, title="Show Delta")
show_buy_sell_volume = input.bool(true, title="Show Buy/Sell Volume Labels")

// Imbalance Settings
grp_imbalance = 'Footprint Imbalance Settings'
show_imbalance = input.bool(true, title="Show Imbalances", group=grp_imbalance)
imbalance_mode = input.string("Diagonal", title="Imbalance Mode", options=["Diagonal", "Horizontal"], group=grp_imbalance)
imbalance_ratio = input.float(3.0, title="Imbalance Ratio Threshold", minval=1.0, step=0.5, group=grp_imbalance)
imbalance_min_vol = input.float(10.0, title="Imbalance Minimum Volume", minval=0.0, group=grp_imbalance, tooltip="Minimum volume required at the level to qualify for imbalance")
col_imb_buy = input.color(#179c74, title="Buy Imbalance Color", group=grp_imbalance)
col_imb_sell = input.color(#f23645, title="Sell Imbalance Color", group=grp_imbalance)

box_width = input.float(0.6, title="Profile Width Ratio", minval=0.1, maxval=10.0, step = 0.1, group=GlobalGroup)
rt_offset = 2 // input.int(2, title="Realtime Profile Offset (Bars)", minval=1, maxval=20)
levels_count = input.int(20, title="Volume Profile Levels", minval=5, maxval=100)
value_area_pct = 70 // input.int(70, title="Value Area %", minval=10, maxval=100)
profile_gap = input.int(2, title="Gap Between Candle & Profile (Bars)", minval=0, maxval=10, group=GlobalGroup)
show_large_vol = input.bool(true, "Identify Large Volume Levels", group=GlobalGroup)
large_vol_mult = input.float(1.5, "Large Vol Multiplier (vs Avg)", minval=1.0, step=0.1, group=GlobalGroup)
show_lvn = input.bool(true, title="Show LVN (Low Volume Nodes)", group=GlobalGroup)
lvn_threshold = input.int(15, title="LVN Threshold (%)", minval=1, maxval=50, group=GlobalGroup)
show_hvn = input.bool(true, title="Show HVN (High Volume Nodes)", group=GlobalGroup)
hvn_threshold = input.int(70, title="HVN Threshold (%)", minval=1, maxval=100, group=GlobalGroup)
show_logo = input.bool(true, title="Show Brand Logo", group=GlobalGroup)
l_off = input.int(85, title="Logo Offset (Bars)", group=GlobalGroup)

// Colors Assignment
