//@version=6
indicator("Liquidation Heatmap Volume Profile 𝙈𝙤𝙪𝙣𝙩𝘼𝙡𝙜𝙤", shorttitle="LQN Heatmap VP 𝙈𝙤𝙪𝙣𝙩𝘼𝙡𝙜𝙤", overlay=true, max_lines_count=500, max_boxes_count=500, max_bars_back=2000)

// -----------------------------------------------------------------------------
// USER DEFINED TYPES
// -----------------------------------------------------------------------------
type LiqZone
    line t_ln
    line b_ln
    linefill f_id
    float level
    float step
    int strength
    bool is_long_liq
    bool active

// -----------------------------------------------------------------------------
// GROUP & INPUTS
// -----------------------------------------------------------------------------
GlobalGroup = "Visual Themes & Global"
color_theme = input.string(defval = 'DEX Deep', title = 'Select Color Theme', options = ['Spartan Edge Theme', 'MountAlgo Themes', 'MountAlgo Neon', 'MountAlgo Frost', 'MountAlgo Cyber', 'Standard Spartan Edge Theme', 'Dark ICT Theme', 'Garuda Gold', 'MountAlgo Super Premium Theme', 'MountAlgo Orange White Theme', 'DEX Deep', 'Deep Sea'], group=GlobalGroup)

// Colors
color dark   = #000000
color white  = #c4d3ff
color green  = #179c74
color purple = #5134ff
color gray   = #62647a
color red    = #f23645
color yellow = #f3ba2f
color orange = #ff9800
color blue   = #1848cc

col_bull = switch color_theme
    'Spartan Edge Theme' => red
    'MountAlgo Themes' => purple
    'MountAlgo Neon' => #5134ff
    'MountAlgo Frost' => #5134ff
    'MountAlgo Cyber' => #1848cc
    'Standard Spartan Edge Theme' => green
    'Dark ICT Theme' => green
    'Garuda Gold' => yellow
    'MountAlgo Super Premium Theme' => purple
    'MountAlgo Orange White Theme' => orange
    'DEX Deep' => #a1ff3b
    'Deep Sea' => blue
    => blue
col_bear = switch color_theme
    'Spartan Edge Theme' => gray
    'MountAlgo Themes' => green
    'MountAlgo Neon' => #ff009a
    'MountAlgo Frost' => #00e5ff
    'MountAlgo Cyber' => #ff009a
    'Standard Spartan Edge Theme' => red
    'Dark ICT Theme' => gray
    'Garuda Gold' => gray
    'MountAlgo Super Premium Theme' => yellow
    'MountAlgo Orange White Theme' => gray
    'DEX Deep' => #ff009a
    'Deep Sea' => gray
    => white
col_poc = switch color_theme
    'Spartan Edge Theme' => white
    'MountAlgo Themes' => white
    'MountAlgo Neon' => white
    'MountAlgo Frost' => white
    'MountAlgo Cyber' => white
    'Standard Spartan Edge Theme' => white
    'Dark ICT Theme' => white
    'Garuda Gold' => white
    'MountAlgo Super Premium Theme' => white
    'MountAlgo Orange White Theme' => white
    'DEX Deep' => white
    'Deep Sea' => white
    => white

transparent_col = color.new(dark, 100)

// Volume Profile Settings
VPGroup = "Volume Profile Config"
levels_count = input.int(20, title="Volume Profile Levels", minval=5, maxval=100, group=VPGroup)
value_area_pct = input.int(70, title="Value Area %", minval=10, maxval=100, group=VPGroup)
vp_lookback = input.int(100, title="Volume Profile Lookback Length", minval=10, group=VPGroup)

// Liquidation Settings
LiqGroup = "Liquidation Settings"
show_liq_heatmap = input.bool(true, "Show Liquidation Heatmap", group=LiqGroup)
lev1 = input.float(25.0, "Leverage 1", group=LiqGroup)
lev2 = input.float(50.0, "Leverage 2", group=LiqGroup)
lev3 = input.float(100.0, "Leverage 3", group=LiqGroup)
maint_margin = input.float(0.5, "Maintenance Margin (%)", minval=0.0, maxval=5.0, step=0.1, group=LiqGroup) / 100

// -----------------------------------------------------------------------------
// VOLUME PROFILE & POC ENGINE
// -----------------------------------------------------------------------------
float s_high = ta.highest(high, vp_lookback)
float s_low = ta.lowest(low, vp_lookback)
float s_vol = 0.0
for idx = 0 to vp_lookback - 1
    s_vol += nz(volume[idx])

float range_price = s_high - s_low
float step = range_price / levels_count

get_buy_sell_vol(v, o, h, l, c) =>
    range_size = h - l
    float b_vol = 0.0
    float s_vol_val = 0.0
    if range_size > 0
        float b_high = math.max(o, c)
        float b_low  = math.min(o, c)
        float body_size = b_high - b_low
        float upper_wick = h - b_high
        float lower_wick = b_low - l

        float w_body = body_size / range_size
        float w_upper = upper_wick / range_size
        float w_lower = lower_wick / range_size

        float b_center = (o + c) / 2
        float body_pos = (b_center - l) / range_size
        float br_b = c > o ? math.min(0.9, 0.6 + body_pos * 0.3) : (c < o ? math.max(0.1, 0.4 - (1.0 - body_pos) * 0.3) : 0.5)

        b_vol := v * (w_body * br_b + w_lower * 0.9 + w_upper * 0.1)
        s_vol_val := v * (w_body * (1.0 - br_b) + w_upper * 0.9 + w_lower * 0.1)
    else
        b_vol := v * 0.5
        s_vol_val := v * 0.5
    [b_vol, s_vol_val]

distribute_vol(int _rows, float _lowest_p, float _inv_row_h, float _o, float _h, float _l, float _c, float _v_total, float[] _bucket_total, float[] _bucket_buy) =>
    float b_high = math.max(_o, _c)
    float b_low  = math.min(_o, _c)
    float _range_val = _h - _l
    int max_idx = _rows - 1

    if max_idx >= 0
        if _range_val <= 0
            int idx = math.min(max_idx, math.max(0, math.floor((_c - _lowest_p) * _inv_row_h)))
            array.set(_bucket_total, idx, array.get(_bucket_total, idx) + _v_total)
            float v_half = _v_total * 0.5
            array.set(_bucket_buy, idx, array.get(_bucket_buy, idx) + v_half)
        else
            float inv_range = 1.0 / _range_val
            float w_l = (b_low - _l) * inv_range
            float w_b = (b_high - b_low) * inv_range
            float w_u = (_h - b_high) * inv_range

            float v_l = _v_total * w_l
            float v_b = _v_total * w_b
            float v_u = _v_total * w_u

            float b_center = (_o + _c) * 0.5
            float body_pos = (b_center - _l) * inv_range

            float br_b = _c > _o ? math.min(0.9, 0.6 + body_pos * 0.3) : (_c < _o ? math.max(0.1, 0.4 - (1.0 - body_pos) * 0.3) : 0.5)

            if v_l > 0
                int idx_l = math.min(max_idx, math.max(0, math.floor((_l - _lowest_p) * _inv_row_h)))
                int idx_h = math.min(max_idx, math.max(0, math.floor((b_low - _lowest_p) * _inv_row_h)))
                if idx_l <= idx_h
                    float v_j = v_l / (idx_h - idx_l + 1)
                    float v_j_buy = v_j * 0.90
                    for j = idx_l to idx_h
                        array.set(_bucket_total, j, array.get(_bucket_total, j) + v_j)
                        array.set(_bucket_buy, j, array.get(_bucket_buy, j) + v_j_buy)
            if v_b > 0
                int idx_l = math.min(max_idx, math.max(0, math.floor((b_low - _lowest_p) * _inv_row_h)))
                int idx_h = math.min(max_idx, math.max(0, math.floor((b_high - _lowest_p) * _inv_row_h)))
                if idx_l <= idx_h
                    float v_j = v_b / (idx_h - idx_l + 1)
                    float v_j_buy = v_j * br_b
                    for j = idx_l to idx_h
                        array.set(_bucket_total, j, array.get(_bucket_total, j) + v_j)
                        array.set(_bucket_buy, j, array.get(_bucket_buy, j) + v_j_buy)
            if v_u > 0
                int idx_l = math.min(max_idx, math.max(0, math.floor((b_high - _lowest_p) * _inv_row_h)))
                int idx_h = math.min(max_idx, math.max(0, math.floor((_h - _lowest_p) * _inv_row_h)))
                if idx_l <= idx_h
                    float v_j = v_u / (idx_h - idx_l + 1)
                    float v_j_buy = v_j * 0.10
                    for j = idx_l to idx_h
                        array.set(_bucket_total, j, array.get(_bucket_total, j) + v_j)
                        array.set(_bucket_buy, j, array.get(_bucket_buy, j) + v_j_buy)

// Build arrays
var vol_dist = array.new<float>(levels_count, 0.0)
var buy_dist = array.new<float>(levels_count, 0.0)

if barstate.islast
    array.fill(vol_dist, 0.0)
    array.fill(buy_dist, 0.0)
    float inv_step = range_price > 0 ? 1.0 / step : 0.0
    for i = 0 to vp_lookback - 1
        _o = open[i]
        _h = high[i]
        _l = low[i]
        _c = close[i]
        _v = volume[i]
        distribute_vol(levels_count, s_low, inv_step, _o, _h, _l, _c, _v, vol_dist, buy_dist)

// Find POC
float max_vol = 0.0
int poc_idx = 0
if barstate.islast
    for i = 0 to levels_count - 1
        v_ = array.get(vol_dist, i)
        if v_ > max_vol
            max_vol := v_
            poc_idx := i

float poc_price = s_low + (step * (poc_idx + 0.5))

// -----------------------------------------------------------------------------
// LIQUIDATION ENGINE BASED ON POC
// -----------------------------------------------------------------------------
var array<LiqZone> liq_zones = array.new<LiqZone>()
var array<line> liq_lines_hist = array.new_line()
var array<linefill> liq_fills_hist = array.new<linefill>()

float liq_step = step
float inv_liq_step = step > 0 ? 1.0 / step : 0.0
float inv_fade_range_liq = step > 0 ? 1.0 / (80 * step) : 0.0

get_heatmap_color(float s, bool is_long, float level) =>
    float val = math.min(s, 20.0)

    // Adaptive theme-integrated gradient colors:
    // Low strength: highly saturated dark/shadow version of the active theme color (col_bull/col_bear mixed with black)
    // Mid strength: pure theme color (col_bull/col_bear)
    // High strength: brilliant white/hotspot highlight (col_poc)
    color t_col  = is_long ? col_bull : col_bear
    color c_low  = color.from_gradient(25, 0, 100, dark, t_col)
    color c_mid  = t_col
    color c_high = col_poc

    color res = val <= 10.0 ? color.from_gradient(val, 1, 10.0, c_low, c_mid) : color.from_gradient(val, 10.0, 20.0, c_mid, c_high)

    float q_weight = math.pow(math.max(0, (val - 1.0) * 0.0526315789), 0.8)
    int base_alpha = math.round((1.0 - q_weight) * 45) // Enhanced transparency for pristine glass overlays
    float smooth_f = math.pow(math.min(1.0, math.abs(level - close) * inv_fade_range_liq), 2.0)
    color.new(res, math.round(base_alpha + smooth_f * (100 - base_alpha)))

add_or_update_liq(float raw_price, bool is_long, int bar_idx) =>
    float grid_price = math.round(raw_price * inv_liq_step) * liq_step
    bool found = false
    int sz_liq = array.size(liq_zones)
    if sz_liq > 0
        for i = 0 to sz_liq - 1
            LiqZone z = array.get(liq_zones, i)
            if z.active and z.is_long_liq == is_long and math.abs(z.level - grid_price) < (z.step * 0.75)
                z.strength += 1
                color c = get_heatmap_color(z.strength, is_long, z.level)
                if line.get_x1(z.t_ln) == bar_index
                    linefill.set_color(z.f_id, c)
                else
                    line.set_x2(z.t_ln, bar_index)
                    line.set_x2(z.b_ln, bar_index)
                    array.push(liq_lines_hist, z.t_ln)
                    array.push(liq_lines_hist, z.b_ln)
                    array.push(liq_fills_hist, z.f_id)

                    z.t_ln := line.new(bar_index, z.level + z.step/2, bar_index + 120, z.level + z.step/2, color=na, width=1)
                    z.b_ln := line.new(bar_index, z.level - z.step/2, bar_index + 120, z.level - z.step/2, color=na, width=1)
                    z.f_id := linefill.new(z.t_ln, z.b_ln, color=c)
                found := true
                break
    if not found
        color c = get_heatmap_color(1, is_long, grid_price)
        l_t = line.new(bar_idx, grid_price + liq_step/2, bar_index + 120, grid_price + liq_step/2, color=na, width=1)
        l_b = line.new(bar_idx, grid_price - liq_step/2, bar_index + 120, grid_price - liq_step/2, color=na, width=1)
        f = linefill.new(l_t, l_b, color=c)
        array.push(liq_zones, LiqZone.new(l_t, l_b, f, grid_price, liq_step, 1, is_long, true))

// Fire levels on new confirmed bars (from POC of the volume profile)
if show_liq_heatmap and barstate.islast
    // Calculate and trigger liquidation levels relative to current POC
    add_or_update_liq(poc_price * (1 + 1/lev1 - maint_margin), false, bar_index)
    add_or_update_liq(poc_price * (1 + 1/lev2 - maint_margin), false, bar_index)
    add_or_update_liq(poc_price * (1 + 1/lev3 - maint_margin), false, bar_index)

    add_or_update_liq(poc_price * (1 - 1/lev1 + maint_margin), true, bar_index)
    add_or_update_liq(poc_price * (1 - 1/lev2 + maint_margin), true, bar_index)
    add_or_update_liq(poc_price * (1 - 1/lev3 + maint_margin), true, bar_index)

// Clean up/Update zones
if show_liq_heatmap
    int sz_liq_z = array.size(liq_zones)
    if sz_liq_z > 0
        for i = sz_liq_z - 1 to 0
            LiqZone z = array.get(liq_zones, i)
            bool remove = false
            if z.active
                line.set_x2(z.t_ln, bar_index + 120)
                line.set_x2(z.b_ln, bar_index + 120)
                linefill.set_color(z.f_id, get_heatmap_color(z.strength, z.is_long_liq, z.level))

                bool swept = z.is_long_liq ? low <= (z.level + z.step * 0.1) : high >= (z.level - z.step * 0.1)
                if swept and bar_index > line.get_x1(z.t_ln)
                    line.set_x2(z.t_ln, bar_index)
                    line.set_x2(z.b_ln, bar_index)
                    z.active := false
                    array.push(liq_lines_hist, z.t_ln)
                    array.push(liq_lines_hist, z.b_ln)
                    array.push(liq_fills_hist, z.f_id)
                    remove := true

            if not remove and line.get_x1(z.t_ln) < bar_index - 300
                line.delete(z.t_ln)
                line.delete(z.b_ln)
                remove := true

            if remove
                array.remove(liq_zones, i)

    if array.size(liq_lines_hist) > 0
        for i = array.size(liq_lines_hist) - 1 to 0
            ln = array.get(liq_lines_hist, i)
            if line.get_x1(ln) < bar_index - 500
                line.delete(ln)
                array.remove(liq_lines_hist, i)
    if array.size(liq_fills_hist) > 250
        linefill.delete(array.shift(liq_fills_hist))
